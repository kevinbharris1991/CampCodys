Options -Indexes
RewriteEngine On

RewriteRule ^ - [E=HTTP_AUTHORIZATION:%{HTTP:Authorization}]
RewriteRule ^$ /public/ [R=302,L]
RewriteRule ^(public|developers/api/v1)$ /$1/ [R=302,L]
RewriteRule ^api/v1(?:/.*)?$ api/v1/index.php [END]
RewriteRule ^public/(?:index\.php|style\.css)?$ - [END]
RewriteRule ^developers/api/v1/(?:index\.html)?$ - [END]
RewriteRule ^ - [F,END]
