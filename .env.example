APP_ENV=production
APP_REQUIRE_TLS=true
DB_DSN=mysql:host=127.0.0.1;port=3306;dbname=camp_codys;charset=utf8mb4
DB_USER=camp_codys
DB_PASSWORD=REPLACE_WITH_DATABASE_PASSWORD
# Generate with: php bin/console.php key
APP_ENCRYPTION_KEY=REPLACE_WITH_BASE64_32_BYTE_KEY
# Self-registration: fixed trusted absolute portal URL (must end exactly /public/).
# HTTPS is mandatory in production. No Host/forwarded-header origin inference.
APP_PUBLIC_URL=https://your-camp-host/public/
APP_MAIL_FROM=accounts@your-camp-host.example
# Configure PHP mail() transport (sendmail_path or platform SMTP) outside .env.
# Required for a remote database in production; PEM CA file, verified by PDO.
# DB_SSL_CA=/path/to/trusted-mysql-ca.pem
# Portal settings are read from its process environment (not this .env file).
PORTAL_API_BASE_URL=https://your-camp-host/api/v1
PORTAL_API_TOKEN=REPLACE_WITH_PROVISIONED_CLIENT_TOKEN
PORTAL_API_SECRET=REPLACE_WITH_PROVISIONED_CLIENT_SECRET
# Point to your published policies; both are required to display portal registration.
PORTAL_TERMS_URL=https://your-camp-host/terms
PORTAL_PRIVACY_URL=https://your-camp-host/privacy
